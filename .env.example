# PostgreSQL
POSTGRES_DB=dockerforge
POSTGRES_USER=dockerforge
POSTGRES_PASSWORD=replace_with_a_strong_local_password

# Application connection strings
DATABASE_URL=postgresql://dockerforge:replace_with_a_strong_local_password@postgres:5432/dockerforge
REDIS_URL=redis://redis:6379/0

# Application logging
LOG_LEVEL=INFO

# Grafana administrator credentials
GRAFANA_ADMIN_PASSWORD=replace_with_a_strong_unique_password
