{
    "uid":  "dockerforge-overview",
    "title":  "DOCKERFORGE - Application Monitoring",
    "tags":  [
                 "dockerforge",
                 "monitoring",
                 "fastapi"
             ],
    "timezone":  "browser",
    "schemaVersion":  41,
    "version":  1,
    "refresh":  "15s",
    "time":  {
                 "from":  "now-1h",
                 "to":  "now"
             },
    "panels":  [
                   {
                       "id":  1,
                       "title":  "HTTP Requests Per Second",
                       "type":  "timeseries",
                       "gridPos":  {
                                       "h":  8,
                                       "w":  12,
                                       "x":  0,
                                       "y":  0
                                   },
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "dockerforge-prometheus"
                                      },
                       "targets":  [
                                       {
                                           "expr":  "sum(rate(dockerforge_http_requests_total[5m]))",
                                           "legendFormat":  "Requests/sec",
                                           "refId":  "A"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "reqps"
                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "options":  {
                                       "legend":  {
                                                      "displayMode":  "list",
                                                      "placement":  "bottom"
                                                  },
                                       "tooltip":  {
                                                       "mode":  "single"
                                                   }
                                   }
                   },
                   {
                       "id":  2,
                       "title":  "HTTP Requests by Status Code",
                       "type":  "timeseries",
                       "gridPos":  {
                                       "h":  8,
                                       "w":  12,
                                       "x":  12,
                                       "y":  0
                                   },
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "dockerforge-prometheus"
                                      },
                       "targets":  [
                                       {
                                           "expr":  "sum by (status_code) (rate(dockerforge_http_requests_total[5m]))",
                                           "legendFormat":  "{{status_code}}",
                                           "refId":  "A"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "reqps"
                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "options":  {
                                       "legend":  {
                                                      "displayMode":  "list",
                                                      "placement":  "bottom"
                                                  },
                                       "tooltip":  {
                                                       "mode":  "multi"
                                                   }
                                   }
                   },
                   {
                       "id":  3,
                       "title":  "HTTP Request Latency - p95",
                       "type":  "timeseries",
                       "gridPos":  {
                                       "h":  8,
                                       "w":  12,
                                       "x":  0,
                                       "y":  8
                                   },
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "dockerforge-prometheus"
                                      },
                       "targets":  [
                                       {
                                           "expr":  "histogram_quantile(0.95, sum by (le) (rate(dockerforge_http_request_duration_seconds_bucket[5m])))",
                                           "legendFormat":  "p95 latency",
                                           "refId":  "A"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "s"
                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "options":  {
                                       "legend":  {
                                                      "displayMode":  "list",
                                                      "placement":  "bottom"
                                                  },
                                       "tooltip":  {
                                                       "mode":  "single"
                                                   }
                                   }
                   },
                   {
                       "id":  4,
                       "title":  "API Scrape Availability",
                       "type":  "stat",
                       "gridPos":  {
                                       "h":  8,
                                       "w":  6,
                                       "x":  12,
                                       "y":  8
                                   },
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "dockerforge-prometheus"
                                      },
                       "targets":  [
                                       {
                                           "expr":  "up{job=\"dockerforge-api\"}",
                                           "legendFormat":  "API",
                                           "refId":  "A"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "min":  0,
                                                            "max":  1,
                                                            "mappings":  [
                                                                             {
                                                                                 "type":  "value",
                                                                                 "options":  {
                                                                                                 "0":  {
                                                                                                           "text":  "DOWN",
                                                                                                           "color":  "red"
                                                                                                       },
                                                                                                 "1":  {
                                                                                                           "text":  "UP",
                                                                                                           "color":  "green"
                                                                                                       }
                                                                                             }
                                                                             }
                                                                         ],
                                                            "thresholds":  {
                                                                               "mode":  "absolute",
                                                                               "steps":  [
                                                                                             {
                                                                                                 "color":  "red",
                                                                                                 "value":  null
                                                                                             },
                                                                                             {
                                                                                                 "color":  "green",
                                                                                                 "value":  1
                                                                                             }
                                                                                         ]
                                                                           }
                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "options":  {
                                       "reduceOptions":  {
                                                             "calcs":  [
                                                                           "lastNotNull"
                                                                       ],
                                                             "fields":  "",
                                                             "values":  false
                                                         },
                                       "orientation":  "auto",
                                       "textMode":  "auto",
                                       "colorMode":  "value",
                                       "graphMode":  "none",
                                       "justifyMode":  "center"
                                   }
                   },
                   {
                       "id":  5,
                       "title":  "Total HTTP Requests",
                       "type":  "stat",
                       "gridPos":  {
                                       "h":  8,
                                       "w":  6,
                                       "x":  18,
                                       "y":  8
                                   },
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "dockerforge-prometheus"
                                      },
                       "targets":  [
                                       {
                                           "expr":  "sum(dockerforge_http_requests_total)",
                                           "legendFormat":  "Total requests",
                                           "refId":  "A"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short"
                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "options":  {
                                       "reduceOptions":  {
                                                             "calcs":  [
                                                                           "lastNotNull"
                                                                       ],
                                                             "fields":  "",
                                                             "values":  false
                                                         },
                                       "orientation":  "auto",
                                       "textMode":  "auto",
                                       "colorMode":  "value",
                                       "graphMode":  "none",
                                       "justifyMode":  "center"
                                   }
                   }
               ],
    "annotations":  {
                        "list":  [
                                     {
                                         "builtIn":  1,
                                         "datasource":  {
                                                            "type":  "grafana",
                                                            "uid":  "-- Grafana --"
                                                        },
                                         "enable":  true,
                                         "hide":  true,
                                         "iconColor":  "rgba(0, 211, 255, 1)",
                                         "name":  "Annotations \u0026 Alerts",
                                         "type":  "dashboard"
                                     }
                                 ]
                    },
    "links":  [

